{
	"name": "pi-toolbelt",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Personal toolbelt for the pi coding agent: tools, workflow commands, UI tweaks, and themes",
	"keywords": [
		"pi-package"
	],
	"bin": {
		"pi-proc": "./bin/pi-proc.mjs"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"themes": [
			"./themes"
		]
	},
	"scripts": {
		"clean": "echo 'nothing to clean'",
		"build": "echo 'nothing to build'",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"test": "node --experimental-strip-types --test tests/**/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && tsc --noEmit && pnpm test",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@clack/prompts": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^0.75.3",
		"@earendil-works/pi-tui": "^0.75.3",
		"@sinclair/typebox": "^0.34.49",
		"commander": "^14.0.3",
		"jiti": "^2.7.0",
		"node-html-markdown": "^2.0.0",
		"picocolors": "^1.1.1",
		"shell-quote": "^1.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/shell-quote": "^1.7.5",
		"typescript": "6.0.3"
	},
	"optionalDependencies": {
		"node-pty": "^1.0.0"
	}
}
